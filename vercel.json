{
  "name": "vauls-ai-rag",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "env": {
    "GROQ_API_KEY": "@groq_api_key",
    "QDRANT_URL": "@qdrant_url",
    "QDRANT_API_KEY": "@qdrant_api_key",
    "POSTGRES_PRISMA_URL": "@postgres_url"
  },
  "functions": {
    "pages/api/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
